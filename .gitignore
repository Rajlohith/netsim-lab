# =====================================================================================================================
# NetSim Lab .gitignore
#
# Rule of thumb used here: ignore by LOCATION and by KIND OF FILE-THAT-IS-ALWAYS-GENERATED, never by data extension.
# .csv / .json / .png files are real, tracked project content (JSON schemas, test fixtures, README screenshots),
# so they are NOT ignored globally.
# =====================================================================================================================

# --- Python ----------------------------------------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / frontend --------------------------------------------------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-error.log*
# NOTE: frontend/package-lock.json is deliberately NOT ignored. Commit it after the first `make frontend-install`.

# --- Secrets and local configuration ----------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Runtime output (created on demand: API database, run files, campaigns, reports, pid files and logs) -----------------
data/
.run/

# --- Release archives and packaging leftovers --------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz

# --- Logs, captures and scratch ---------------------------------------------------------------------------------------
*.log
*.pcap
*.pcapng
*.tmp
*.bak

# --- Editors and operating systems -------------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
.directory
