# Copy to .env and adjust. Every variable is optional (defaults in backend/app/config.py).
NETSIM_ENVIRONMENT=development
NETSIM_API_HOST=127.0.0.1
NETSIM_API_PORT=8000
NETSIM_CORS_ORIGINS=["http://localhost:5173"]
# Prefix for every namespace/interface this project creates (later stages).
# Anything without this prefix is never touched.
NETSIM_NETNS_PREFIX=nsl-
# The topology CLI is dry-run unless --execute is passed (scripts/topology.sh passes it) or this is false.
NETSIM_DRY_RUN=true
NETSIM_DATA_DIR=data
