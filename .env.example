# Copy to .env and adjust. Every variable is optional (defaults in backend/app/config.py).
NETSIM_ENVIRONMENT=development
NETSIM_API_HOST=127.0.0.1
NETSIM_API_PORT=8000
NETSIM_CORS_ORIGINS=["http://localhost:5173"]
# Prefix for every namespace/interface this project creates (later stages).
# Anything without this prefix is never touched.
NETSIM_NETNS_PREFIX=nsl-
# The topology CLI is dry-run unless --execute is passed (scripts/topology.sh passes it) or this is false.
NETSIM_DRY_RUN=true
NETSIM_DATA_DIR=data

# ---- Stage 8 API (read by app.services.settings; process environment wins over this file) -------------------------------------
# NETSIM_API_DATA_DIR=data/api              # SQLite database + one directory per experiment (relative paths: from the project root)
# NETSIM_API_MAX_CONCURRENT_JOBS=2          # worker processes at once
# NETSIM_API_MAX_QUEUE=20                   # waiting experiments before POST /api/experiments answers 429
# NETSIM_API_MAX_RUNTIME_S=300              # wall-clock limit per experiment (then killed, status failed/timeout)
# NETSIM_API_CANCEL_GRACE_S=3               # SIGTERM -> SIGKILL delay when cancelling
# NETSIM_API_RETENTION_DAYS=30              # delete finished experiments after N days (0 = keep forever)
# NETSIM_API_MAX_DURATION_S=120             # per-request limits (tighter than the runner's own)
# NETSIM_API_MAX_RATE_PPS=1000
# NETSIM_API_MAX_PROBES=120000              # duration_s * rate_pps
# NETSIM_API_ENVIRONMENTS=emulated,loopback # 'live' (privileged) can never be enabled
# NETSIM_API_MODEL_DIRS=stage6=examples/ml/stage6/model
# NETSIM_API_TOKEN=                         # if set, every /api route except /api/health needs "Authorization: Bearer <token>"
# NETSIM_API_ALLOW_ROOT=0                   # the job manager refuses to run as root; 1 only inside a disposable container
